## APP Config
APP_NAME=nestjs-boilerplate
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

# Orígenes permitidos: * = todos (usar en test); en producción: URL o IP del servicio que puede llamar (ej. https://auth-api, 10.0.0.1). Varios separados por coma.
ALLOWED_ORIGINS=*

# Clientes permitidos por IP:PUERTO. * = todos (usar en test). En producción: IP:PUERTO del/los servicios que pueden llamar (ej. 10.0.0.5:3000). Varios separados por coma.
# Ejemplo real: ALLOWED_CLIENTS=10.0.0.5:3000,10.0.0.6:3001
ALLOWED_CLIENTS=*

## DB Config LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=boilerplate
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=boilerplate

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000