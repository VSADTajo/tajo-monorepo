## APP Config
APP_NAME=nestjs-boilerplate
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

## DB Config LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=boilerplate
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=boilerplate

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## Storage Config
STORAGE_BASE_PATH=/data/files
STORAGE_MAX_FILE_SIZE=524288000

## SFTP Client Config
SFTP_CONNECTION_TIMEOUT=10000
SFTP_OPERATION_TIMEOUT=60000

## SFTP Server Config (embedded)
SFTP_SERVER_ENABLED=false
SFTP_SERVER_PORT=8212
SFTP_SERVER_HOST_KEY_PATH=/data/sftp/host_key
SFTP_SERVER_AUTO_GENERATE_HOST_KEY=true
SFTP_SERVER_MAX_CONNECTIONS=10
SFTP_SERVER_USERS=[]

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

## Auth API Config (ms-authentication-api — service-to-service)
AUTH_API_URL=http://localhost:3002