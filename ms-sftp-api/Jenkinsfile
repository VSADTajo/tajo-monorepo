pipeline {
    agent any

    environment {
        APP_NAME          = 'ms-sftp-api'
        APP_PORT          = '3003'
        SFTP_PORT         = '8212'
        DB_HOST           = 'infra-db-sftp'
        DB_DATABASE       = 'ms_sftp'
        NODE_VERSION      = '22'
        FRONTEND_NAME     = 'sftp-frontend'
        FRONTEND_PORT     = '5174'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.BRANCH_NAME_SAFE = env.BRANCH_NAME?.replaceAll('/', '-') ?: 'main'
                    env.IMAGE_TAG = "${env.BRANCH_NAME_SAFE}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            steps {
                sh 'npm run test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'junit.xml'
                }
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    sh """
                        DOCKER_BUILDKIT=1 docker build \
                            --target prod \
                            -t ${APP_NAME}:${IMAGE_TAG} \
                            .
                    """
                }
            }
        }

        stage('Frontend - Docker Build') {
            steps {
                script {
                    // No --build-arg for the URL: the image bakes a runtime
                    // placeholder (see frontend Dockerfile + docker-entrypoint.sh)
                    // so one image works on any host. The real URL is injected
                    // at container start via AUTH_API_URL.
                    sh """
                        docker build \
                            --target prod \
                            -t ${FRONTEND_NAME}:${IMAGE_TAG} \
                            ./frontend
                    """
                }
            }
        }

        // Publish both images to GHCR, then redeploy each in place with the
        // live container's exact config (verbatim env + volumes, auto-rollback).
        // Replaces the old local `docker run` for API and frontend. Deploy
        // scripts live in the Jenkins home (/var/jenkins_home/deploy) — see
        // docs/jenkins-ghcr-deploy.md.
        stage('Publish & Deploy') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'ghcr',
                                  usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    // API
                    sh """
                        SERVICE=${APP_NAME} \
                        LOCAL_IMAGE=${APP_NAME}:${IMAGE_TAG} \
                        REGISTRY=ghcr.io/vsadtajo \
                        TAG=${IMAGE_TAG} \
                        bash /var/jenkins_home/deploy/publish-and-deploy.sh
                    """
                    // Frontend (nginx SPA)
                    sh """
                        SERVICE=${FRONTEND_NAME} \
                        LOCAL_IMAGE=${FRONTEND_NAME}:${IMAGE_TAG} \
                        REGISTRY=ghcr.io/vsadtajo \
                        TAG=${IMAGE_TAG} \
                        bash /var/jenkins_home/deploy/publish-and-deploy.sh
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully! Deployed ${APP_NAME}:${IMAGE_TAG} on port ${APP_PORT} and ${FRONTEND_NAME}:${IMAGE_TAG} on port ${FRONTEND_PORT}"
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
        always {
            deleteDir()
        }
    }
}
