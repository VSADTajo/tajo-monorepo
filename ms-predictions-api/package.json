{
    "name": "auth-3ds-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22",
        "npm": ">=10.5"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "start:demo": "node demo/card-tokenizer.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./jest-e2e.json --runInBand",
        "prepare": "if [ \"$NODE_ENV\" = \"development\" ]; then husky install; fi",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli --dataSource=./src/configuration/postgres/db-config.ts",
        "typeorm:prod": "node -r tsconfig-paths/register ./node_modules/typeorm/cli --dataSource=dist/src/configuration/postgres/db-config.js",
        "migration:run": "npm run typeorm migration:run",
        "migration:run:prod": "npm run typeorm:prod migration:run",
        "migration:generate": "npm run typeorm migration:generate",
        "migration:create": "npm run typeorm -- migration:create ./src/migrations/$npm_config_name",
        "migration:revert": "npm run typeorm -- -d ./src/config/typeorm.ts migration:revert"
    },
    "dependencies": {
        "@adminjs/express": "^6.1.0",
        "@adminjs/typeorm": "^5.0.1",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/microservices": "^11.1.14",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.0.0",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/typeorm": "^11.0.0",
        "adminjs": "^7.8.13",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^0.10.9",
        "axios": "^1.3.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "form-data": "^4.0.6",
        "helmet": "^7.1.0",
        "ioredis": "^5.9.3",
        "nestjs-pino": "^4.1.0",
        "openai": "^5.1.1",
        "pg": "^8.12.0",
        "pino-http": "^10.2.0",
        "pino-pretty": "^11.2.2",
        "react": "^17.0.2",
        "react-json-view": "^1.21.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "tajo-toolkit": "github:VSADTajo/tajo-toolkit#v1.1.0",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.20",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.4.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@testcontainers/postgresql": "^11.12.0",
        "@types/amqplib": "^0.10.8",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.2",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.0",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "husky": "^9.1.4",
        "jest": "^29.5.0",
        "lint-staged": "^15.2.8",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "testcontainers": "^11.12.0",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "typescript": "^5.7.0"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "npm run format",
            "eslint --fix",
            "git add -A"
        ]
    }
}
