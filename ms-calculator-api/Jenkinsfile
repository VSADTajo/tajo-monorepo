pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ms-calculator-api'
        CONTAINER_PORT = '3011'
        DEPLOY_HOST = '65.21.97.113'
        DEPLOY_USER = 'root'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build (dev)') {
            steps {
                sh """
                    DOCKER_BUILDKIT=1 docker build \\
                        --target dev \\
                        -t ${IMAGE_NAME}-ci:\${BUILD_NUMBER} \\
                        .
                """
            }
        }

        stage('Lint') {
            steps {
                sh "docker run --rm ${IMAGE_NAME}-ci:\${BUILD_NUMBER} ruff check src tests"
            }
        }

        stage('Test') {
            steps {
                sh """
                    docker run --rm \\
                        -v \${WORKSPACE}:/junit \\
                        ${IMAGE_NAME}-ci:\${BUILD_NUMBER} \\
                        pytest -v --junitxml=/junit/junit.xml --ignore=tests/integration/test_amqp_consumer_publisher.py
                """
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'junit.xml'
                }
            }
        }

        stage('Docker Build (prod)') {
            steps {
                sh """
                    DOCKER_BUILDKIT=1 docker build \\
                        --target prod \\
                        -t ${IMAGE_NAME}:\${BUILD_NUMBER} \\
                        -t ${IMAGE_NAME}:latest \\
                        .
                """
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    docker stop ${IMAGE_NAME} || true
                    docker rm ${IMAGE_NAME} || true
                    docker run -d \\
                        --name ${IMAGE_NAME} \\
                        --restart unless-stopped \\
                        --network infra-network \\
                        -p ${CONTAINER_PORT}:${CONTAINER_PORT} \\
                        -e NODE_ENV=production \\
                        -e RABBITMQ_HOST=infra-rabbitmq \\
                        -e RABBITMQ_PORT=5672 \\
                        -e RABBITMQ_USER=guest \\
                        -e RABBITMQ_PASSWORD=guest \\
                        -e RABBITMQ_VHOST=/ \\
                        -e APP_PORT=${CONTAINER_PORT} \\
                        -e APP_LOG_LEVEL=info \\
                        -e LOGS_API_URL=http://ms-logs-api:3004 \\
                        -e X_API_KEY="\${X_API_KEY}" \\
                        ${IMAGE_NAME}:latest
                """
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}
