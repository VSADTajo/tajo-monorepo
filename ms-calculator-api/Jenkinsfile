pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ms-calculator-api'
        APP_PORT   = '3011'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.BRANCH_NAME_SAFE = env.BRANCH_NAME?.replaceAll('/', '-') ?: 'main'
                    env.IMAGE_TAG = "${env.BRANCH_NAME_SAFE}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Docker Build (dev)') {
            steps {
                sh """
                    DOCKER_BUILDKIT=1 docker build \\
                        --target dev \\
                        -t ${IMAGE_NAME}-ci:${IMAGE_TAG} \\
                        .
                """
            }
        }

        stage('Lint') {
            steps {
                sh "docker run --rm ${IMAGE_NAME}-ci:${IMAGE_TAG} ruff check src tests"
            }
        }

        stage('Test') {
            steps {
                sh """
                    docker run --rm \\
                        -v \${WORKSPACE}:/junit \\
                        ${IMAGE_NAME}-ci:${IMAGE_TAG} \\
                        pytest -v --junitxml=/junit/junit.xml --ignore=tests/integration/test_amqp_consumer_publisher.py
                """
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'junit.xml'
                }
            }
        }

        stage('Docker Build (prod)') {
            steps {
                sh """
                    DOCKER_BUILDKIT=1 docker build \\
                        --target prod \\
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \\
                        .
                """
            }
        }

        // Publish the built image to GHCR, then redeploy it in place with the
        // live container's exact config (verbatim env, auto-rollback). Replaces
        // the old local `docker run`. redeploy.sh detects this is a non-Node
        // (Python) image and probes /health over the container network instead
        // of via node. Deploy scripts live in the Jenkins home
        // (/var/jenkins_home/deploy) — see docs/jenkins-ghcr-deploy.md.
        stage('Publish & Deploy') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'ghcr',
                                  usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    sh """
                        SERVICE=${IMAGE_NAME} \\
                        LOCAL_IMAGE=${IMAGE_NAME}:${IMAGE_TAG} \\
                        REGISTRY=ghcr.io/vsadtajo \\
                        TAG=${IMAGE_TAG} \\
                        bash /var/jenkins_home/deploy/publish-and-deploy.sh
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully! Deployed ${IMAGE_NAME}:${IMAGE_TAG} on port ${APP_PORT}"
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
        always {
            deleteDir()
        }
    }
}
