# ms-calculator-api — environment variables
# Copy to .env and override as needed

# Application
APP_NAME=ms-calculator-api
APP_PORT=3011
APP_LOG_LEVEL=info
NODE_ENV=local

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10

# Reservoir configuration (relative path resolved from the src/ directory)
RESERVOIR_CONFIG_PATH=src/config/reservoir_parameters.json

# Health check
HEALTH_AMQP_TIMEOUT_MS=1000

# ms-logs-api shipper — leave LOGS_API_URL empty to disable HTTP shipping
# (stdout-only mode, useful in tests or if the collector is offline).
# Example prod value: http://ms-logs-api:3004
LOGS_API_URL=
X_API_KEY=
