pipeline {
    agent any

    environment {
        APP_NAME     = 'ms-logs-api'
        UI_NAME      = 'ms-logs-ui'
        APP_PORT     = '3004'
        UI_PORT      = '3005'
        NODE_VERSION = '22'

        // Infra ms-logs-api (server-side: internal Docker network URL)
        URL_API_GATEWAY = 'http://ms-gateway-api:3000'
        FRONTEND_URL    = 'http://65.21.97.113:3005'
        MONGO_URI       = "mongodb://root:${MONGO_PASSWORD}@infra-mongo-logs:27017/apilogs?authSource=admin"
        DOCKER_NETWORK  = 'infra-network'

        // Vite build args (browser-side: public IP, gateway on port 80)
        VITE_API_URL          = 'http://65.21.97.113:3004'
        VITE_URL_API_GATEWAY  = 'http://65.21.97.113'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.BRANCH_NAME_SAFE = env.BRANCH_NAME?.replaceAll('/', '-') ?: 'main'
                    env.IMAGE_TAG = "${env.BRANCH_NAME_SAFE}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Lint') {
            when {
                expression { fileExists('package.json') && readFile('package.json').contains('"lint"') }
            }
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            when {
                expression { fileExists('package.json') && readFile('package.json').contains('"test"') }
            }
            steps {
                sh 'npm run test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'junit.xml'
                }
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // API
                    sh """
                        docker build \
                            --target prod \
                            -t ${APP_NAME}:${IMAGE_TAG} \
                            .
                    """
                    // UI (Vite — reads .env.production at build time; no build-args needed)
                    sh """
                        docker build \
                            -f ui/Dockerfile \
                            --target prod \
                            --no-cache \
                            -t ${UI_NAME}:${IMAGE_TAG} \
                            .
                    """
                }
            }
        }

        // Publish the built image to GHCR, then redeploy it in place with the
        // live container's exact config (verbatim, auto-rollback). Replaces the
        // old local `docker run`. Deploy scripts live in the Jenkins home
        // (/var/jenkins_home/deploy) — see docs/jenkins-ghcr-deploy.md.
        stage('Publish & Deploy') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'ghcr',
                                  usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    sh """
                        SERVICE=${APP_NAME} \
                        LOCAL_IMAGE=${APP_NAME}:${IMAGE_TAG} \
                        REGISTRY=ghcr.io/vsadtajo \
                        TAG=${IMAGE_TAG} \
                        bash /var/jenkins_home/deploy/publish-and-deploy.sh
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully! Deployed ${APP_NAME}:${IMAGE_TAG} on port ${APP_PORT}"
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
        always {
            deleteDir()
        }
    }
}

