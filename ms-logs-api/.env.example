# API
URL_API_GATEWAY=http://65.21.97.113:3000
PORT=3004
UI_PORT=3005
FRONTEND_URL=http://65.21.97.113:3005
NODE_ENV=development

# Mongo (docker-compose). Si no se definen, se usan root / localdev en local.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=localdev
# authSource=admin es necesario para el usuario root
MONGO_URI=mongodb://root:localdev@ms-logs-api-mongo:27017/apilogs?authSource=admin

# UI build (docker-compose usa estos como build args)
VITE_URL_API_GATEWAY=http://65.21.97.113:3000
VITE_API_URL=http://65.21.97.113:3004
VITE_APP_ENV=test
