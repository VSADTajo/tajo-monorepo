// =============================================================================
// DEPRECATED — not used. The `ms-logs-ui` multibranch job is disabled.
//
// The logs UI is now built AND deployed from the main ms-logs-api Jenkinsfile
// (build + publish-and-deploy to GHCR) with runtime URL config (see
// ui/Dockerfile + ui/docker-entrypoint.sh). The VITE_* env vars and
// --build-arg flags below are DEAD: the Dockerfile bakes runtime placeholders
// that take precedence, and the hardcoded IPs are stale. Kept for reference —
// do not re-enable without migrating to the GHCR publish flow.
// =============================================================================
pipeline {
  agent any

  environment {
    APP_NAME     = 'ms-logs-ui'
    UI_PORT      = '3005'
    NODE_VERSION = '22'
    DOCKER_NETWORK = 'infra-network'
  }

  options {
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(
            script: 'git rev-parse --short HEAD',
            returnStdout: true
          ).trim()
          env.BRANCH_NAME_SAFE = env.BRANCH_NAME?.replaceAll('/', '-') ?: 'main'
          env.IMAGE_TAG = "${env.BRANCH_NAME_SAFE}-${env.GIT_COMMIT_SHORT}"
        }
      }
    }

    stage('Install UI deps') {
      steps {
        dir('ui') {
          sh 'npm ci'
        }
      }
    }

    stage('Build UI') {
      steps {
        dir('ui') {
          sh 'npm run build'
        }
      }
    }

    stage('Docker Build (nginx)') {
      steps {
        script {
          sh """
            docker build \\
              -f ui/Dockerfile \\
              -t ${APP_NAME}:${IMAGE_TAG} \\
              .
          """
        }
      }
    }

    stage('Deploy UI') {
      steps {
        script {
          sh """
            docker stop ${APP_NAME} || true
            docker rm ${APP_NAME} || true

            docker run -d \\
              --name ${APP_NAME} \\
              --network ${DOCKER_NETWORK} \\
              --restart unless-stopped \\
              -p ${UI_PORT}:80 \\
              ${APP_NAME}:${IMAGE_TAG}
          """
        }
      }
    }
  }

  post {
    success {
      echo "UI deployed: ${APP_NAME}:${IMAGE_TAG} on port ${UI_PORT}"
    }
    always {
      deleteDir()
    }
  }
}

