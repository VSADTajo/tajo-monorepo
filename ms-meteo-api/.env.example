## APP Config
APP_NAME=ms-meteo-api
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3010
APP_LOG_LEVEL=info

## DB Config (ms-meteo-api own database)
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=ms_meteo
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=ms_meteo

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

## SFTP API (file source)
SFTP_API_URL=http://ms-sftp-api:8212
SFTP_API_INTERNAL_CALLER=ms-meteo-api
METEO_BASE_PATH=tajo/METEO

## GeoServer REST (publishing target)
GEOSERVER_URL=http://vsad-tajo-geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=tajo

## Meteo ingest pipeline
METEO_GEOTIFF_DIR=/opt/datasets/meteo
METEO_SYNC_CRON=0 */3 * * *
METEO_RETENTION_DAYS=7
METEO_RETENTION_MODE=today

# Aerial precipitation
AERIAL_PRECIP_SFTP_DIRECTORY=/tagus/pareal # Root directory in the SFTP server where FEWS precipitation JSONs land
AERIAL_PRECIP_POLL_INTERVAL_MS=300000 # How often the poller runs in milliseconds (default: 5 minutes)
AERIAL_PRECIP_FILE_PREFIXES=tagus_eps_Pareal_,tagus_harmonie_Pareal_,tagus_saih_Pareal_ # Comma-separated list of accepted file-name prefixes
AERIAL_PRECIP_RETENTION_DAYS=30 # How many days of forecast snapshots to keep
AERIAL_PRECIP_CLEANUP_CRON=0 3 * * * # When to run the retention cleanup (cron expression, default: daily at 03:00 UTC)
AERIAL_PRECIP_LIST_CACHE_TTL_SECONDS=60 # Redis TTL in seconds for filtered list queries
AERIAL_PRECIP_LATEST_CACHE_TTL_SECONDS=300 # Redis TTL in seconds for the "latest per polygon" query
