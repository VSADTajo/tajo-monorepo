# =============================================================================
# Platform version pin — single source of truth for the image TAG.
#
# This file is auto-managed by Jenkinsfile.release on every push to
# monorepo/main. Do NOT edit by hand — your change will be overwritten on the
# next release.
#
# The tag applied to ALL 14 services (13 backends + vsad-tajo-frontend). Every
# release bumps it in lockstep, so `bin/tajo up` always pulls a coherent set.
#
# Client flow:
#   git pull                    # gets new TAG here
#   bin/tajo up                 # pulls exact set for that TAG
#
# Rollback:
#   TAG=v2026.09.10.42 bin/tajo up      # override in shell
#   or set TAG in infra/.env             # override per host
# =============================================================================
TAG=latest
