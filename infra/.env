# =============================================================================
# VSAD Tajo — platform configuration, COMMITTED ON PURPOSE.
#
# `git pull && bin/tajo up` must work with zero manual steps, so this file ships
# the real values, copied from the environment of the production containers on
# our Hetzner server. It never holds GitHub/GHCR/Jenkins tokens.
#
# PUBLIC_* URLs are NOT here: tajo derives them from this machine's IP (or from
# PUBLIC_HOST if you set it below), so the browser always talks to THIS host.
#
# Per-host overrides (e.g. PUBLIC_HOST=tajo.cliente.es) can be added at the end.
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT
# -----------------------------------------------------------------------------
# Container image registry. Used by docker-compose.apps.yml as:
#   image: ${REGISTRY}/<service>:${TAG}
# For local dev (with docker-compose.dev.yml override) images are built locally.
REGISTRY=ghcr.io/vsadtajo

# TAG is NOT set here. It lives in infra/version.env (versioned in git, bumped
# automatically by CI on every merge to main). Uncomment ONLY to pin a specific
# release for this host (e.g. rollback after a bad release):
# TAG=v2026.09.10.42


# Runtime env (production | staging | local)
NODE_ENV=production
APP_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# POSTGRES (shared credentials — one user/password across all 8 Postgres
# instances; each instance owns a different database per service)
# -----------------------------------------------------------------------------
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='TGJManbhyqzSUwE06LjWqktVH4HJlKCvMSewuZhY'

# Per-service database names. Matches docker-compose.base.yml POSTGRES_DB.
DB_USER_DATABASE=user_db
DB_SFTP_DATABASE=sftp_db
DB_PREDICTIONS_DATABASE=predictions_db
DB_HYDRO_DATABASE=hydro_db
DB_MODEL_DATABASE=model_db
DB_NOTIFICATIONS_DATABASE=notifications_db
DB_METEO_DATABASE=meteo_db
# Must stay 'geoserver': the GeoServer stores in infra/seed/geoserver point at it.
DB_GEOSERVER_DATABASE=geoserver

# -----------------------------------------------------------------------------
# MONGODB (ms-logs-api)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME='root'
MONGO_INITDB_ROOT_PASSWORD='7u5k79OEflMQ9VsGrM4r4D9c'
MONGO_INITDB_DATABASE='apilogs'
# Full URI used by ms-logs-api. Container DNS = infra-mongo-logs.
MONGO_URI='mongodb://root:7u5k79OEflMQ9VsGrM4r4D9c@infra-mongo-logs:27017/apilogs?authSource=admin'

# -----------------------------------------------------------------------------
# REDIS (shared cache + permission/JWT store)
# -----------------------------------------------------------------------------
# Inside the compose network the host is always infra-redis:6379.
REDIS_DEFAULT_TTL='300'
# REDIS_PASSWORD=  # leave empty for no auth (matches default Redis 7 alpine)

# -----------------------------------------------------------------------------
# RABBITMQ (shared message broker)
# -----------------------------------------------------------------------------
RABBITMQ_USER='guest'
RABBITMQ_PASSWORD='guest'
RABBITMQ_VHOST='/'
RABBITMQ_PREFETCH='10'
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

# -----------------------------------------------------------------------------
# AUTHENTICATION (ms-authentication-api)
# -----------------------------------------------------------------------------
JWT_SECRET='your-super-secret-key-change-in-production'
JWT_EXPIRATION='1h'
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=15d

# -----------------------------------------------------------------------------
# INTERNAL API KEY — shared by ms-sftp-api, ms-hydro-api and ms-calculator-api
# (required: ms-calculator-api refuses to start without it).
# -----------------------------------------------------------------------------
X_API_KEY='c230ca6d42bfa46a1965f62011e60300218a72e6401cef36990615616aa9d481'

# -----------------------------------------------------------------------------
# GATEWAY (ms-gateway-api) — bypass list for RBAC checks
# -----------------------------------------------------------------------------
RBAC_BYPASS_ROLES='admin'

# -----------------------------------------------------------------------------
# SFTP (ms-sftp-api)
# -----------------------------------------------------------------------------
SFTP_PORT=8212
# File storage paths inside the container (mounted to named volumes).
SFTP_FILE_STORAGE_PATH=/data/files
SFTP_KEYS_PATH=/data/sftp

# -----------------------------------------------------------------------------
# GEOSERVER
# -----------------------------------------------------------------------------
GEOSERVER_ADMIN_USER='admin'
GEOSERVER_ADMIN_PASSWORD='geoserver'
# JVM heap (raise for large rasters / heavy concurrent requests).
GEOSERVER_INITIAL_MEMORY=512M
GEOSERVER_MAXIMUM_MEMORY=2G



# -----------------------------------------------------------------------------
# INTEGRATIONS & TUNING (copied from the production containers)
# -----------------------------------------------------------------------------
REDIS_PERMISSION_TTL='300'
ALLOWED_ORIGINS='*'
AEMET_API_KEY='eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmbG93Y2F0QGFkYXNhc2lzdGVtYXMuY29tIiwianRpIjoiZmYwMDg5NGMtOWRmOC00ZjMzLWIxZGItZDA0MDBmYjI1ZDRkIiwiaXNzIjoiQUVNRVQiLCJpYXQiOjE3NTY5MDA0NTcsInVzZXJJZCI6ImZmMDA4OTRjLTlkZjgtNGYzMy1iMWRiLWQwNDAwZmIyNWQ0ZCIsInJvbGUiOiIifQ.bjShX8LZvfcyykyiKlkH17POqVq1_HlAEWhRcnLGqas'
AEMET_BASE_URL='https://opendata.aemet.es/opendata'
AEMET_DEFAULT_AREA='esp'
METEO_BASE_PATH='tajo/METEO'
METEO_GEOTIFF_DIR='/opt/datasets/meteo'
METEO_RETENTION_CRON='0 3 * * *'
METEO_RETENTION_DAYS='7'
METEO_RETENTION_MODE='today'
METEO_SYNC_CRON='0 */3 * * *'
VOBS_CSV_SFTP_PATH='tajo/wiski/Tagus_FlowCast.csv'
VOBS_CSV_TIMEZONE='Europe/Madrid'
USE_CALCULATOR_PIPELINE='true'
STATION_THRESHOLD_CACHE_TTL='300'
GEOSERVER_WORKSPACE='Tajo'

# -----------------------------------------------------------------------------
# PER-HOST OVERRIDES
# -----------------------------------------------------------------------------
# Host-specific values and secrets go in infra/.env.local (not committed), e.g.
#   PUBLIC_HOST=tajo.cliente.es     # default: this machine's IP
#   WISKI_API_TOKEN=...             # WISKI REST token (from CH Tajo)
