# =============================================================================
# VSAD Tajo — unified env file
#
# Copy to infra/.env and customize. Every service in docker-compose.apps.yml
# reads from THIS file (env_file: ./.env). Service-specific overrides live in
# the `environment:` block of each service in apps.yml — never duplicate here.
#
# Required vars are uncommented; advanced/optional vars are commented out
# with their default behavior noted.
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT
# -----------------------------------------------------------------------------
# Container image registry + tag. Used by docker-compose.apps.yml as:
#   image: ${REGISTRY}/<service>:${TAG}
# For local dev (with docker-compose.dev.yml override) images are built locally.
REGISTRY=ghcr.io/vsadtajo
TAG=latest

# Public hostname the browser uses to talk to the platform.
# Used as build-arg by vsad-tajo-frontend when baking VITE_API_URL.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_GEOSERVER_URL=http://localhost:8085/geoserver

# Runtime env (production | staging | local)
NODE_ENV=production
APP_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# POSTGRES (shared credentials — one user/password across all 8 Postgres
# instances; each instance owns a different database per service)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# Per-service database names. Matches docker-compose.base.yml POSTGRES_DB.
DB_USER_DATABASE=user_db
DB_SFTP_DATABASE=sftp_db
DB_PREDICTIONS_DATABASE=predictions_db
DB_HYDRO_DATABASE=hydro_db
DB_MODEL_DATABASE=model_db
DB_NOTIFICATIONS_DATABASE=notifications_db
DB_METEO_DATABASE=meteo_db
DB_GEOSERVER_DATABASE=geoserver_db

# -----------------------------------------------------------------------------
# MONGODB (ms-logs-api)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production
MONGO_INITDB_DATABASE=apilogs
# Full URI used by ms-logs-api. Container DNS = infra-mongo-logs.
MONGO_URI=mongodb://root:change-me-in-production@infra-mongo-logs:27017/apilogs?authSource=admin

# -----------------------------------------------------------------------------
# REDIS (shared cache + permission/JWT store)
# -----------------------------------------------------------------------------
# Inside the compose network the host is always infra-redis:6379.
REDIS_DEFAULT_TTL=300
# REDIS_PASSWORD=  # leave empty for no auth (matches default Redis 7 alpine)

# -----------------------------------------------------------------------------
# RABBITMQ (shared message broker)
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

# -----------------------------------------------------------------------------
# AUTHENTICATION (ms-authentication-api)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRATION=1h
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=15d

# -----------------------------------------------------------------------------
# GATEWAY (ms-gateway-api) — bypass list for RBAC checks
# -----------------------------------------------------------------------------
RBAC_BYPASS_ROLES=admin

# -----------------------------------------------------------------------------
# SFTP (ms-sftp-api)
# -----------------------------------------------------------------------------
SFTP_PORT=8212
# File storage paths inside the container (mounted to named volumes).
SFTP_FILE_STORAGE_PATH=/data/files
SFTP_KEYS_PATH=/data/sftp

# -----------------------------------------------------------------------------
# GEOSERVER
# -----------------------------------------------------------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me-in-production
# JVM heap (raise for large rasters / heavy concurrent requests).
GEOSERVER_INITIAL_MEMORY=512M
GEOSERVER_MAXIMUM_MEMORY=2G

# -----------------------------------------------------------------------------
# FRONTEND BUILD ARGS (baked into vsad-tajo-frontend at image build time)
# -----------------------------------------------------------------------------
# These are forwarded by the GitHub Actions workflow when building the
# frontend image. Override per environment by setting them in the workflow
# (or rebuild locally with `tajo build vsad-tajo-frontend`).
VITE_API_URL=${PUBLIC_API_URL}
VITE_GEOSERVER_URL=${PUBLIC_GEOSERVER_URL}
