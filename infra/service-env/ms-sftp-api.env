# Env vars declared in main that the older feature-branch container did not
# carry. redeploy.sh merges these in when they are missing from runlike's
# clone of the current container config, so a recreate does not crash-loop.
#
# All values are internal (container DNS + defaults from docker-compose.apps.yml).
AUTH_API_URL=http://ms-authentication-api:3002
SFTP_SERVER_HOST_KEY_PATH=/data/sftp/host_key
STORAGE_BASE_PATH=/data/files
NODE_ENV=production
LOGS_API_URL=http://ms-logs-api:3004
