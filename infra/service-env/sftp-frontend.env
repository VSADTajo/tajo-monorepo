# Runtime URL the sftp-frontend nginx entrypoint substitutes into built assets
# (see ms-sftp-api/frontend/docker-entrypoint.sh). Aborts if AUTH_API_URL is
# missing, so without this file a recreate crash-loops (runlike can only copy
# variables the previous container already had, and this one did not exist
# before the image became runtime-configurable).
#
# Value mirrors infra/.env PUBLIC_API_URL — the browser hits the gateway there.
AUTH_API_URL=http://65.21.97.113
