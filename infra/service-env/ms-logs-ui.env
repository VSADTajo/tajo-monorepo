# Runtime URLs the logs UI image substitutes into its built assets on start
# (see ms-logs-api/ui/docker-entrypoint.sh). The entrypoint aborts if any of
# them is missing, so without this file a recreate crash-loops: runlike can
# only copy variables the previous container already had, and these did not
# exist before the image became runtime-configurable.
#
# Values mirror infra/.env (PUBLIC_* keys) and the docker-compose.apps.yml
# mapping. Keep both in sync when the public URLs change.
API_URL=http://65.21.97.113:3004
GATEWAY_URL=http://65.21.97.113
SCHEDULER_URL=http://65.21.97.113
PREDICTIONS_URL=http://65.21.97.113:3007
