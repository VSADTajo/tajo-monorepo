## APP Config
APP_NAME=ms-gateway-api
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

## Downstream Service URLs
AUTH_API_URL=http://localhost:3002
USER_API_URL=http://localhost:3001
SFTP_API_URL=http://localhost:3003

## Redis (for permission cache)
REDIS_HOST=infra-redis
REDIS_PORT=6379
REDIS_PERMISSION_TTL=300

## RBAC
RBAC_BYPASS_ROLES=admin
