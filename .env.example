## APP Config
APP_NAME=nestjs-boilerplate
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

## DB Config LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=boilerplate
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=boilerplate

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## Hydro API Config
HYDRO_API_BASE_URL=http://localhost:3004
STATION_THRESHOLD_CACHE_TTL=300

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000