## APP Config
APP_NAME=nestjs-boilerplate
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

## DB Config LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=boilerplate
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=boilerplate

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

## FEWS API Config — the direct model flow (modelSource=FEWS_API) and the FEWS_API data providers
# Values below are Idrica's for the CH Tajo instance (endpoints_FEWS_TagusFlowCast.xlsx).
# The host only resolves inside their network.
FEWS_API_BASE_URL=http://cpdfews2.saihchtajo.es:8080/FewsWebServices
# Path of the PI REST service under the base URL. The default matches a standard deployment.
FEWS_API_SERVICE_PATH=/rest/fewspiservice/v1
# Workflow launched by a manual simulation: runs the MIKE11 models of the whole basin (10-15 min).
FEWS_WORKFLOW_ID=ForecastMIKE11_mod
# Filter the manual-simulation input is imported under and its results read back from.
FEWS_FILTER_ID=Tajo_Forecasts_mods
# Optional HTTP basic auth. Empty means the service is called unauthenticated.
FEWS_API_USERNAME=
FEWS_API_PASSWORD=
# runtask parameters, as Idrica validated them: userId, runOption, and a startTime
# (= timeZero) one hour before the launch rounded down to the quarter hour, with a
# 3-day horizon.
FEWS_RUN_USER_ID=fews
FEWS_RUN_OPTION=alloneatatime
FEWS_RUN_START_OFFSET_MINUTES=60
FEWS_RUN_HORIZON_DAYS=3
FEWS_TASK_TIMEOUT_MS=1800000
FEWS_TASK_POLL_INTERVAL_MS=15000
FEWS_REQUEST_TIMEOUT_MS=120000

## Mock FEWS — the fake PI REST service backing modelSource=MOCK
# Runs inside this process, so the default points at itself and MOCK needs no setup.
# MOCK_FEWS_BASE_URL=http://127.0.0.1:3008
# How long the fake reports a task as pending/running before completing it. Zero
# completes on the first status read. Set it above SIMULATION_POLL_INTERVAL_MINUTES
# to make the poller genuinely walk through its in-flight branch.
MOCK_FEWS_RUNNING_MS=0

## SFTP API Config
SFTP_API_BASE_URL=http://localhost:3003

## Simulation Polling Config
SIMULATION_POLL_INTERVAL_MINUTES=5

## Calculator Integration
# Set to 'true' to publish manual-simulation output to the calculator topic
# (simulation.manual.output.fetched) instead of the legacy topic
# (timeseries.ingested). Default: false.
USE_CALCULATOR_PIPELINE=false

# Absolute path (on the SFTP mount served by ms-sftp-api) to the WISKI CSV
# containing the observed reservoir volume series (v.obs). Required only when
# USE_CALCULATOR_PIPELINE=true. Example: /simulations/wiski/Tagus_FlowCast.csv
VOBS_CSV_SFTP_PATH=

# IANA timezone for interpreting timestamps in the WISKI CSV before converting
# them to UTC. Default: Europe/Madrid.
VOBS_CSV_TIMEZONE=Europe/Madrid

# Per-fetch timeout in milliseconds for the WISKI CSV download. Default: 30000.
VOBS_CSV_FETCH_TIMEOUT_MS=30000

## Origen del enriquecimiento v.obs de la simulación manual
# SFTP_CSV (por defecto) lee el CSV que WISKI deja en el SFTP; WISKI_API lo pide
# a su endpoint, resolviendo las variables con el mismo catálogo de la ingesta.
VOBS_SOURCE=SFTP_CSV

## WISKI API Config — observed data pulled from their REST service
# Root of their WISKI service. It only resolves inside CH Tajo's network, so
# outside it every call fails at DNS: leave it empty and the provider says so
# instead of issuing a request to nowhere.
WISKI_API_BASE_URL=
WISKI_API_PATH=/wiski/tagus_flowcast_observado/
# The payload carries no UTC offset. This is the assumption the CSV path already
# makes; getting it wrong shifts every reading by one or two hours silently.
WISKI_API_TIMEZONE=Europe/Madrid
WISKI_API_REQUEST_TIMEOUT_MS=120000
WISKI_API_MAX_RESPONSE_BYTES=52428800
# API token issued by CH Tajo, sent as `Authorization: Token <token>`.
WISKI_API_TOKEN=
# The fake WISKI endpoint backing local verification runs inside this process,
# so the default points at itself and needs no setup.
# MOCK_WISKI_BASE_URL=http://127.0.0.1:3008
