## APP Config
APP_NAME=nestjs-boilerplate
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info

## DB Config LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=boilerplate
DB_SYNCHRONIZE=false # Do not set in production
DB_LOGGING=true # Do not set in production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=boilerplate

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## RabbitMQ Config
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

## FEWS API Config — the direct model flow (modelSource=FEWS_API)
# Root of their FewsWebServices deployment, e.g. https://fews.example.org/FewsWebServices
FEWS_API_BASE_URL=http://localhost:8080
# Path of the PI REST service under the base URL. The default matches a standard deployment.
FEWS_API_SERVICE_PATH=/rest/fewspiservice/v1
# Ids defined INSIDE their FEWS — both must come from Idrica, there is no sensible default.
FEWS_WORKFLOW_ID=
FEWS_FILTER_ID=
# Optional HTTP basic auth. Empty means the service is called unauthenticated.
FEWS_API_USERNAME=
FEWS_API_PASSWORD=
FEWS_TASK_TIMEOUT_MS=1800000
FEWS_TASK_POLL_INTERVAL_MS=15000
FEWS_REQUEST_TIMEOUT_MS=60000

## Mock FEWS — the fake PI REST service backing modelSource=MOCK
# Runs inside this process, so the default points at itself and MOCK needs no setup.
# MOCK_FEWS_BASE_URL=http://127.0.0.1:3008
# How long the fake reports a task as pending/running before completing it. Zero
# completes on the first status read. Set it above SIMULATION_POLL_INTERVAL_MINUTES
# to make the poller genuinely walk through its in-flight branch.
MOCK_FEWS_RUNNING_MS=0

## SFTP API Config
SFTP_API_BASE_URL=http://localhost:3003

## Simulation Polling Config
SIMULATION_POLL_INTERVAL_MINUTES=5

## Calculator Integration
# Set to 'true' to publish manual-simulation output to the calculator topic
# (simulation.manual.output.fetched) instead of the legacy topic
# (timeseries.ingested). Default: false.
USE_CALCULATOR_PIPELINE=false

# Absolute path (on the SFTP mount served by ms-sftp-api) to the WISKI CSV
# containing the observed reservoir volume series (v.obs). Required only when
# USE_CALCULATOR_PIPELINE=true. Example: /simulations/wiski/Tagus_FlowCast.csv
VOBS_CSV_SFTP_PATH=

# IANA timezone for interpreting timestamps in the WISKI CSV before converting
# them to UTC. Default: Europe/Madrid.
VOBS_CSV_TIMEZONE=Europe/Madrid

# Per-fetch timeout in milliseconds for the WISKI CSV download. Default: 30000.
VOBS_CSV_FETCH_TIMEOUT_MS=30000