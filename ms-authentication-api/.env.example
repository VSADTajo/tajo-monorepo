## APP Config
APP_NAME=ms-authentication-api
NODE_ENV=development
APP_URL=127.0.0.1
APP_PORT=3002
APP_LOG_LEVEL=info

## User API Config
USER_API_URL=http://localhost:3001

## Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300

## JWT Config
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=1h
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=15d

